---
import {
  fetchEntries,
  fetchOneEntry,
  type BuilderContent,
} from "@builder.io/sdk-react";
import { initializeNodeRuntime } from "@builder.io/sdk-react/node/init";

import BuilderioPage from "../../components/BuilderioPage";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  // @see https://www.builder.io/c/docs/integration-tips#enable-data-bindings-in-node-environments
  initializeNodeRuntime();

  const builderModel = "page";
  const builderAPIpublicKey = import.meta.env.BUILDER_API_PUBLIC_KEY;

  const builderioToUrlLanguageMapping: Record<string, string> = {
    "en-US": "en",
    "es-ES": "es",
    "ja-JP": "ja",
    "ar-SA": "ar",
  };

  const pages: BuilderContent[] = await fetchEntries({
    model: builderModel,
    apiKey: builderAPIpublicKey,
    fields: ["id", "name", "data.slug", "data.title", "data.description"].join(
      ",",
    ),
  });

  const paths = pages.flatMap((page: BuilderContent) => {
    const defaultSlug = page.data?.slug["Default"];

    return Object.entries(page.data?.slug || {}).map(
      ([builderioLocale, url]: [string, string]) => {
        const urlLang = builderioToUrlLanguageMapping[builderioLocale];

        const title = (page.data?.title as unknown as Record<string, string>)?.[
          builderioLocale
        ];
        const description = page.data?.description?.[builderioLocale];

        if (!urlLang) {
          return null;
        }

        const hasCustomSlug = url.trim().length > 0;

        return {
          params: {
            lang: urlLang,
            slug: hasCustomSlug ? url : defaultSlug,
          },
          props: {
            id: page.id,
            title,
            description,
            contentLang: builderioLocale,
          },
        };
      },
    );
  });

  console.log("Generated paths for static generation:", paths.filter(Boolean));
  return paths.filter(Boolean);
}

const builderModel = "page";
const builderApiPublicKey = import.meta.env.BUILDER_API_PUBLIC_KEY;

const { id, title, description, contentLang } = Astro.props;
console.log("builderApiPublicKey", builderApiPublicKey);

const content = await fetchOneEntry({
  model: builderModel,
  apiKey: builderApiPublicKey,
  query: {
    id,
  },
  locale: contentLang,
});
---

<Layout title={title} description={description}>
  {
    id && (
      <BuilderioPage
        client:load
        id={id}
        model={builderModel}
        publicApiKey={builderApiPublicKey}
        apiLocale={contentLang}
        content={content}
      />
    )
  }
</Layout>
